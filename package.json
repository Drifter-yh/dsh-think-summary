{
  "name": "@drifter-yh/dsh-think-summary",
  "version": "0.1.0",
  "description": "Codex-style thinking summaries for DeepSeek Harness: condense each reasoning step into 1-3 bullet points inline, keep the full chain one click away.",
  "author": "DeepSeek Harness community contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drifter-yh/dsh-think-summary.git"
  },
  "homepage": "https://github.com/Drifter-yh/dsh-think-summary#readme",
  "bugs": {
    "url": "https://github.com/Drifter-yh/dsh-think-summary/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "reasoning",
    "thinking",
    "chain-of-thought",
    "summary",
    "codex"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.2.3-0",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js"
  }
}
